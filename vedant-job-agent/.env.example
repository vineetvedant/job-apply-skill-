# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  vedant-job-agent — Environment Configuration                              ║
# ║  Copy this file to .env and fill in every REQUIRED value.                  ║
# ║  NEVER commit .env to version control.                                     ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ──────────────────────────────────────────────────────────────────────────────
# LinkedIn Credentials  (REQUIRED)
# ──────────────────────────────────────────────────────────────────────────────
LINKEDIN_EMAIL=your_linkedin_email@example.com
LINKEDIN_PASSWORD=CHANGE_ME

# ──────────────────────────────────────────────────────────────────────────────
# Gmail SMTP  (REQUIRED for --mode email)
# Generate an App Password: https://myaccount.google.com/apppasswords
# ──────────────────────────────────────────────────────────────────────────────
GMAIL_ADDRESS=your_gmail@example.com
GMAIL_APP_PASSWORD=CHANGE_ME

# ──────────────────────────────────────────────────────────────────────────────
# Resume  (REQUIRED for --mode email)
# Absolute path to the PDF that will be attached to cold emails.
# ──────────────────────────────────────────────────────────────────────────────
RESUME_PATH=/path/to/your/Resume.pdf

# ──────────────────────────────────────────────────────────────────────────────
# Chromium / Browser  (REQUIRED — DO NOT change unless custom build)
# Must point to the native ARM Chromium binary shipped with Raspberry Pi OS.
# ──────────────────────────────────────────────────────────────────────────────
CHROMIUM_PATH=/usr/bin/chromium-browser

# ──────────────────────────────────────────────────────────────────────────────
# Session & Data Directories  (OPTIONAL — sensible defaults shown)
# ──────────────────────────────────────────────────────────────────────────────
SESSION_DIR=~/.linkedin_bot_session
DATA_DIR=~/.vedant_agent_data

# ──────────────────────────────────────────────────────────────────────────────
# Search Configuration  (OPTIONAL)
# Comma-separated keywords used when scanning LinkedIn job posts.
# ──────────────────────────────────────────────────────────────────────────────
SEARCH_KEYWORDS=Python Developer,Backend Engineer,Software Engineer,FastAPI,DevOps Engineer,AI Engineer,ML Engineer,Cloud Engineer

# ──────────────────────────────────────────────────────────────────────────────
# Target Companies  (OPTIONAL)
# Comma-separated list of priority companies for fit-score bonus.
# ──────────────────────────────────────────────────────────────────────────────
TARGET_COMPANIES=Google,Microsoft,Amazon,Meta,Apple,Flipkart,Razorpay,Zerodha,CRED,Atlassian,Adobe,Salesforce,Oracle

# ──────────────────────────────────────────────────────────────────────────────
# Ollama LLM Endpoint  (OPTIONAL)
# If you have Ollama running on another machine on the LAN, point here for
# smarter reply drafting.  Leave blank to use rule-based templates only.
# ──────────────────────────────────────────────────────────────────────────────
OLLAMA_ENDPOINT=

# ──────────────────────────────────────────────────────────────────────────────
# Agent Behavior  (OPTIONAL)
# ──────────────────────────────────────────────────────────────────────────────
# Minimum fit score (0–100) to include a lead in the ledger.
MIN_FIT_SCORE=60

# Delay range (seconds) between page actions to mimic human behavior.
ACTION_DELAY_MIN=2
ACTION_DELAY_MAX=5

# Maximum number of job posts to scan per run.
MAX_POSTS_PER_SCAN=50

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Number of days with no reply before staging a follow-up nudge.
FOLLOWUP_DAYS=3

# Maximum follow-up nudges per conversation thread (prevents spamming).
MAX_FOLLOWUPS_PER_THREAD=2

# ──────────────────────────────────────────────────────────────────────────────
# ecoMode & Security  (vineetvedant/ecoMode)
# ──────────────────────────────────────────────────────────────────────────────
# Enable token-saving semantic compression for LLMs and message templates.
# Saves up to 65%+ tokens and reduces Pi 3B+ CPU and RAM usage.
ECO_MODE=true

# Compression level: 'eco' (default compact, balanced) or 'eco max' (extreme brevity, delta-only)
ECO_MODE_LEVEL=eco

