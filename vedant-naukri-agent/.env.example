# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  vedant-naukri-agent — Environment Configuration Template                  ║
# ║  Copy this file to `.env` and fill in your real credentials:                 ║
# ║      cp .env.example .env && chmod 600 .env                                  ║
# ║  NEVER commit `.env` containing plain-text passwords or API keys to git.    ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ──────────────────────────────────────────────────────────────────────────────
# Naukri Credentials  (REQUIRED)
# ──────────────────────────────────────────────────────────────────────────────
NAUKRI_EMAIL=your_naukri_email@example.com
NAUKRI_PASSWORD=CHANGE_ME

# ──────────────────────────────────────────────────────────────────────────────
# Gmail SMTP Dispatcher  (REQUIRED for --mode email)
# ──────────────────────────────────────────────────────────────────────────────
# Gmail App Password (16 letters, e.g., "abcd efgh ijkl mnop").
# Generate at: Google Account -> Security -> 2-Step Verification -> App Passwords
GMAIL_ADDRESS=your_gmail@example.com
GMAIL_APP_PASSWORD=CHANGE_ME

# ──────────────────────────────────────────────────────────────────────────────
# Candidate Documents & Paths  (REQUIRED)
# ──────────────────────────────────────────────────────────────────────────────
# Path to your latest PDF resume for re-upload and cold email attachments
RESUME_PATH=/home/pi/Resume.pdf

# Path to native ARM64 Chromium binary on Raspberry Pi OS
CHROMIUM_PATH=/usr/bin/chromium-browser

# Browser profile directory storing login cookies across runs
SESSION_DIR=~/.naukri_bot_session

# Directory for storing application ledger, logs, and external job redirects
DATA_DIR=~/.vedant_naukri_data

# ──────────────────────────────────────────────────────────────────────────────
# Candidate Ground-Truth Defaults  (Used for Screening Drawers & Chatbots)
# ──────────────────────────────────────────────────────────────────────────────
CANDIDATE_NAME=Your Name
CANDIDATE_PHONE=+919876543210
CURRENT_COMPANY=Current Company
CURRENT_ROLE=Software Engineer
TOTAL_EXPERIENCE_YEARS=2.0
CURRENT_CTC_LPA=6.0
EXPECTED_CTC_LPA=12.0
NOTICE_PERIOD_DAYS=15
NOTICE_PERIOD_TEXT=15 Days / Immediate
CURRENT_LOCATION=Delhi NCR
PREFERRED_LOCATIONS=Delhi NCR,Bengaluru,Remote
READY_TO_RELOCATE=Yes
HIGHEST_DEGREE=B.Tech/B.E.
COLLEGE_NAME=University Name
PASSING_YEAR=2024
CGPA=8.0

# ──────────────────────────────────────────────────────────────────────────────
# Job Search & Application Filtering
# ──────────────────────────────────────────────────────────────────────────────
# Comma-separated target keywords for Naukri search
SEARCH_KEYWORDS=Python Developer,Generative AI Engineer,FastAPI Backend,SDET Python,Machine Learning Engineer,Software Engineer

# Preferred locations to filter search results
SEARCH_LOCATIONS=Noida,Delhi / NCR,Gurgaon / Gurugram,Bengaluru,Remote

# Maximum age of job postings in days (1-3 days ensures active hiring)
JOB_POSTED_DAYS=3

# Maximum 1-click applications to submit per execution cycle
MAX_APPLICATIONS_PER_RUN=20

# Minimum candidate-to-JD fit score (0-100) to trigger auto-apply
MIN_FIT_SCORE=60

# ──────────────────────────────────────────────────────────────────────────────
# Behavior, Anti-Ban & Human Mimicry
# ──────────────────────────────────────────────────────────────────────────────
# Delay range (seconds) between Playwright clicks and page scrolls
ACTION_DELAY_MIN=2
ACTION_DELAY_MAX=5

# Whether to automatically submit direct 1-click applies after answering screening questions
# Set to 'false' to stage applications for manual review
AUTO_SUBMIT_APPLY=true

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ──────────────────────────────────────────────────────────────────────────────
# ecoMode & Security  (vineetvedant/ecoMode)
# ──────────────────────────────────────────────────────────────────────────────
# Enable token-saving semantic compression for LLM prompts and message templates
ECO_MODE=true

# Compression mode: 'eco' (balanced compact) or 'eco max' (extreme brevity, delta-only)
ECO_MODE_LEVEL=eco
